# Container env for `docker compose` (api, worker, migrate). Local-only values: the S3
# endpoint is the moto service, the credentials are dummies and the bootstrap key is
# public. For a real deployment start from .env.example instead.
TX_ENV=dev
TX_LOG_JSON=true

TX_DATABASE_URL=postgresql+psycopg://tx:tx@postgres:5432/tx
TX_REDIS_URL=redis://redis:6379/0

TX_S3_BUCKET=transcription-audio
TX_S3_ENDPOINT_URL=http://s3:5000
# Presigned upload URLs are used from the host, where moto is published on 5050.
TX_S3_PUBLIC_ENDPOINT_URL=http://localhost:5050
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

TX_BOOTSTRAP_API_KEY=tx_dev_local_only_key
# Lets webhooks reach http:// targets on the host / compose network.
TX_WEBHOOK_ALLOW_PRIVATE_TARGETS=true

TX_WHISPER_MODEL=small
