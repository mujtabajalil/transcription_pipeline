# Production-style configuration against real AWS. Copy to `.env` (read from the working
# directory) or inject as environment variables. Only the values a deployment must set
# or decide are here; every other knob, with its default, is a field of `Settings` in
# src/transcription/config.py (env var = TX_ + field name, upper-cased).

TX_ENV=prod

# --- state ---------------------------------------------------------------------------------
TX_DATABASE_URL=postgresql+psycopg://tx:CHANGE_ME@db.internal:5432/tx
TX_REDIS_URL=rediss://redis.internal:6379/0

# --- object storage (S3) -------------------------------------------------------------------
# AWS credentials are not TX_ settings: boto3 uses its default chain (env vars, shared
# profile, ECS task role / EC2 instance profile). In AWS, attach a role and set nothing;
# elsewhere use AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# AWS_PROFILE=transcription
TX_S3_BUCKET=my-company-transcription-audio
TX_S3_REGION=eu-west-1
# Leave TX_S3_ENDPOINT_URL / TX_S3_PUBLIC_ENDPOINT_URL unset for AWS; they exist for
# S3-compatible stand-ins (moto).
# Server-side encryption: AES256 (S3-managed) or aws:kms (+ TX_S3_KMS_KEY_ID).
# TX_S3_SSE=AES256
# false when the bucket, its encryption and lifecycle are owned by infra-as-code;
# `tx-admin init-storage` then does nothing and the role needs no bucket-admin rights.
# TX_S3_MANAGE_BUCKET=true

# --- ASR engines ---------------------------------------------------------------------------
# faster_whisper | elevenlabs; TX_ASR_FALLBACK=faster_whisper serves chunks locally while
# the hosted engine is unavailable.
# TX_ASR_ENGINE=faster_whisper
# TX_ASR_FALLBACK=none
# TX_ELEVENLABS_API_KEY=
# auto | cpu | cuda; use TX_WHISPER_COMPUTE_TYPE=float16 on GPU.
# TX_WHISPER_DEVICE=auto

# --- safety --------------------------------------------------------------------------------
# Dev only: allows http:// and private/loopback webhook targets (SSRF risk in production).
# TX_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Dev only: ensures this raw key exists at API startup. In production create keys with
# `tx-admin create-key --name ...`.
# TX_BOOTSTRAP_API_KEY=
